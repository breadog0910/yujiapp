  // 加载
  function load() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return deepClone(defaultState);
      const saved = JSON.parse(raw);
      // 浅合并，确保新增字段有默认值
      return deepMerge(deepClone(defaultState), saved);
    } catch (e) {
      console.warn('[State] load failed', e);
      return deepClone(defaultState);
    }
  }

  function save() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch (e) {
      console.warn('[State] save failed', e);
    }
  }

  let state = load();

  // 工具：深合并
  function deepMerge(target, src) {
    for (const k in src) {
      if (src[k] && typeof src[k] === 'object' && !Array.isArray(src[k])) {
        target[k] = deepMerge(target[k] || {}, src[k]);
      } else {
        target[k] = src[k];
      }
    }
    return target;
  }

  function deepClone(o) {
    return JSON.parse(JSON.stringify(o));
  }

  // 每日重置逻辑
  function ensureDaily() {
    const today = new Date().toISOString().slice(0, 10);
    if (state.lastCoinDate !== today) {
      state.dailyCoin = 0;
      state.lastCoinDate = today;
      // 重置今日自我照顾状态
      state.careOptions.forEach(o => o.done = false);
      // 记录访问
      if (!state.visitDates.includes(today)) {
        state.visitDates.push(today);
      }
      save();
    }
  }

  // 数值变更 API
  function addCare(n = 1) {
    state.careValue += n;
    save();
  }

  function addHealth(n = 1) {
    state.healthValue += n;
    save();
  }

  function addHappiness(n = 1) {
    state.happinessValue += n;
    save();
  }

  function addComfort(n = 1) {
    state.comfortValue += n;
    save();
  }

  // 添加金币（受每日上限 20 控制）
  const DAILY_COIN_CAP = 20;
  function addCoin(n) {
    const remain = Math.max(0, DAILY_COIN_CAP - state.dailyCoin);
    const real = Math.min(n, remain);
    state.coin += real;
    state.dailyCoin += real;
    save();
    return real; // 实际给到的金币数
  }

  // 重置
  function reset() {
    state = deepClone(defaultState);
    save();
  }

  // 家具库：根据类型取目录项
  function getCatalog(type) {
    return ROOM_CATALOG.find(c => c.type === type) || null;
  }

  // ============================================================
  // 花园 API（PRD 5.3：行动驱动生长，无时间枯萎）
  // ============================================================

  // 取种子目录项
  function getSeed(key) {
    return SEED_CATALOG.find(c => c.key === key) || null;
  }

  // 种下种子
  function plantSeed(idx, seedKey) {
    if (idx < 0 || idx >= state.plots.length) return false;
    if (state.plots[idx] || !getSeed(seedKey)) return false;
    state.plots[idx] = {
      seedKey,
      stage: 0,
      feed: 0,
      plantedAt: new Date().toISOString(),
    };
    save();
    return true;
  }

  // 行动输送养料：eventKey ∈ selfcare / emotion / interest / express / habit / action
  // 返回被喂养的地块列表 [{idx, seedKey, name, stage, matured}]
  function feedGarden(eventKey, n = 1) {
    const fed = [];
    state.plots.forEach((p, idx) => {
      if (!p) return;
      const seed = getSeed(p.seedKey);
      if (!seed || !seed.feedOn.includes(eventKey)) return;
      const maxStage = seed.stages.length - 1;
      if (p.stage >= maxStage) return; // 已成熟，不再消耗养料
      p.feed += n;
      while (p.feed >= FEED_PER_STAGE && p.stage < maxStage) {
        p.feed -= FEED_PER_STAGE;
        p.stage += 1;
      }
      if (p.stage >= maxStage) p.feed = 0;
      fed.push({
        idx,
        seedKey: p.seedKey,
        name: seed.name,
        stage: p.stage,
        maxStage,
        matured: p.stage >= maxStage,
      });
    });
    if (fed.length) save();
    return fed;
  }

  // 收获成熟地块 → 花园仓库条目（不 push，由调用方决定去向）
  function harvestPlot(idx) {
    const p = state.plots[idx];
    if (!p) return null;
    const seed = getSeed(p.seedKey);
    if (!seed) return null;
    const maxStage = seed.stages.length - 1;
    if (p.stage < maxStage) return null;
    const item = {
      type: 'garden',
      id: 'gw-' + Math.random().toString(36).slice(2, 10) + Date.now().toString(36).slice(-4),
      seedKey: seed.key,
      name: seed.yield.name,
      emoji: seed.yield.emoji,
      source: '生长花园',
      bonus: { ...seed.yield.bonus },
    };
    state.plots[idx] = null;
    save();
    return item;
  }

  return {
    get state() { return state; },
    save,
    load,
    reset,
    ensureDaily,
    addCare,
    addHealth,
    addHappiness,
    addComfort,
    addCoin,
    DAILY_COIN_CAP,
    roomCatalog: ROOM_CATALOG,
    bgCatalog: BG_CATALOG,
    seedCatalog: SEED_CATALOG,
    FEED_PER_STAGE,
    getCatalog,
    getSeed,
    plantSeed,
    feedGarden,
    harvestPlot,
  };
})();
