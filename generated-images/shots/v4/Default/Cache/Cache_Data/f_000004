/* ============================================================
   Tab1 此刻·家 - 像素房间 + 可动可交互 + 背景可增删改
   ============================================================ */

const Tab1 = (() => {

  let editMode = false;     // 布置模式
  let selectedId = null;    // 当前选中的家具 id

  // 像素风照顾选项图标（SVG 点阵，代替 emoji）
  const CARE_ICONS = {
    water: `
