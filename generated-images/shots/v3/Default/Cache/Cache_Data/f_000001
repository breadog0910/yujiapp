/* ============================================================
   Tab1 此刻·家 - 像素房间（可动可交互 + 背景可增删改）
   ============================================================ */

.tab1-room {
  position: relative;
  height: 58%;
  overflow: hidden;
  background: linear-gradient(180deg, #f0dcc0 0%, #d8b890 100%);
  transition: filter 0.6s ease;
}

/* ---------- 背景堆叠：多张底图，只有 active 显示 ---------- */
.tab1-bg-stack {
  position: absolute;
  inset: 0;
}
.tab1-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center bottom;
  opacity: 0;
  transition: opacity 0.8s ease;
  image-rendering: pixelated;
}
.tab1-bg.active {
  opacity: 1;
}

/* 不同时段背景：微调整体色温氛围 */
#roomStage[data-bg-time="morning"] { }
#roomStage[data-bg-time="evening"] .window-light {
  opacity: 0.55;
  background: linear-gradient(115deg, rgba(255, 190, 140, 0) 0%, rgba(255, 190, 140, 0.32) 38%, rgba(255, 190, 140, 0) 78%);
}
#roomStage[data-bg-time="night"] .window-light {
  opacity: 0.4;
  background: linear-gradient(115deg, rgba(160, 180, 255, 0) 0%, rgba(160, 180, 255, 0.28) 38%, rgba(160, 180, 255, 0) 78%);
}
#roomStage[data-bg-time="night"] .room-glow {
  background: radial-gradient(ellipse at 50% 30%, rgba(255, 220, 170, 0.3) 0%, transparent 70%);
}
#roomStage[data-bg-time="night"] .dust-motes { opacity: 0.5; }

/* ---------- 远景：窗光 + 尘埃 ---------- */
.window-light {
  position: absolute;
  top: 0;
  left: 18%;
  width: 34%;
  height: 78%;
  background: linear-gradient(115deg, rgba(255, 246, 220, 0) 0%, rgba(255, 246, 220, 0.38) 38%, rgba(255, 246, 220, 0) 78%);
  clip-path: polygon(30% 0, 70% 0, 95% 100%, 5% 100%);
  mix-blend-mode: screen;
  animation: beam-sway 9s ease-in-out infinite alternate;
  pointer-events: none;
  transition: opacity 1s ease;
}

@keyframes beam-sway {
  0%   { transform: translateX(-6px) skewX(-1deg); opacity: 0.85; }
  100% { transform: translateX(10px) skewX(1.5deg); opacity: 1; }
}

.dust-motes { position: absolute; inset: 0; pointer-events: none; transition: opacity 1s ease; }

/* 关爱值控制房间柔光 */
.room-glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 50% 30%, rgba(255, 240, 200, 0.35) 0%, transparent 70%);
  pointer-events: none;
  transition: all 1s ease;
  mix-blend-mode: screen;
  z-index: 4;
}

/* ---------- 中层：家具组件 ---------- */
.room-furniture {
  position: absolute;
  inset: 0;
}

.room-item {
  position: absolute;
  width: var(--ri-w, 56px);
  height: var(--ri-h, 56px);
  margin-left: calc(var(--ri-w, 56px) / -2);   /* 水平居中于锚点 */
  margin-bottom: -4px;                          /* 底部微沉，贴地 */
  transform: scale(var(--ri-scale, 1)) scaleX(var(--ri-flip, 1));
  transform-origin: center bottom;
  cursor: pointer;          /* 普通模式：点击交互 */
  touch-action: none;
  transition: filter 0.2s ease;
  filter: drop-shadow(0 3px 3px rgba(80, 50, 30, 0.28));
}

.room-item .ri-sprite {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  image-rendering: pixelated;
  transition: transform 0.15s ease;
  filter: drop-shadow(0 2px 2px rgba(60, 35, 20, 0.25));
}
.room-item .ri-sprite img {
  max-width: 100%;
  max-height: 100%;
  width: auto;
  height: auto;
  object-fit: contain;
  image-rendering: pixelated;
}

.room-item .ri-shadow {
  position: absolute;
  bottom: 2px;
  left: 50%;
  transform: translateX(-50%);
  width: 34px;
  height: 8px;
  background: radial-gradient(ellipse, rgba(70, 45, 25, 0.35) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
  transition: transform 0.2s ease, opacity 0.2s ease;
}
/* 地毯这类贴地物件不画影子 */
.room-item.is-floor .ri-shadow { display: none; }

.room-item .ri-label {
  position: absolute;
  top: calc(100% + 2px);
  left: 50%;
  transform: translateX(-50%);
  font-size: 10px;
  font-weight: bold;
  color: rgba(90, 70, 50, 0.85);
  background: rgba(255, 252, 245, 0.75);
  padding: 1px 6px;
  border-radius: 999px;
  border: 1.5px solid var(--c-line);
  white-space: nowrap;
  letter-spacing: 0.5px;
  opacity: 0;
  transition: opacity 0.2s ease;
  pointer-events: none;
}

/* 远景层家具：更小更暗，有距离感 */
.room-item[data-depth="far"] {
  opacity: 0.82;
  filter: brightness(0.92) saturate(0.92) drop-shadow(0 2px 2px rgba(80, 50, 30, 0.18));
}
.room-item[data-depth="near"] {
  filter: brightness(1.04) drop-shadow(0 5px 6px rgba(80, 50, 30, 0.3));
}

/* 有交互动作的家具：轻呼吸提示 */
.room-item.has-action .ri-sprite {
  animation: ri-breathe 3.2s ease-in-out infinite;
}
@keyframes ri-breathe {
  0%, 100% { transform: translateY(0) scale(1); }
  50%      { transform: translateY(-3px) scale(1.04); }
}

/* 点击物件：轻轻弹一下 */
.room-item.clicked .ri-sprite {
  animation: ri-bounce 0.32s ease;
}
@keyframes ri-bounce {
  0%   { transform: translateY(0) scale(1); }
  35%  { transform: translateY(-7px) scale(1.08) rotate(-3deg); }
  70%  { transform: translateY(1px) scale(0.97); }
  100% { transform: translateY(0) scale(1); }
}

/* 移除时缩小的动画 */
.room-item.removing {
  transition: transform 0.22s ease, opacity 0.22s ease;
  transform: scale(0.3);
  opacity: 0;
}

/* 拖动中的家具：放大 + 提亮 */
.room-item.dragging {
  cursor: grabbing;
  z-index: 999 !important;
  filter: brightness(1.12) drop-shadow(0 10px 12px rgba(80, 50, 30, 0.35));
}
.room-item.dragging .ri-sprite { transform: scale(1.12); }
.room-item.dragging .ri-shadow { transform: translateX(-50%) scale(0.8); opacity: 0.7; }

/* 普通模式悬浮显示名字 */
.room-item:hover .ri-label { opacity: 1; }

/* ---------- 编辑模式 ---------- */
body.room-editing .room-item {
  cursor: move;             /* 布置模式：拖动移动 */
}
body.room-editing .room-item.dragging { cursor: grabbing; }
body.room-editing .room-item .ri-label { opacity: 1; }

.room-item.selected {
  outline: 3px dashed #d4a574;
  outline-offset: 4px;
  border-radius: 10px;
}

.room-item .ri-badge {
  position: absolute;
  top: -14px;
  right: -14px;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  border: 2px solid #fff;
  background: #d4a574;
  color: #fff;
  font-size: 12px;
  font-weight: bold;
  display: none;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  z-index: 3;
}
.room-item.selected .ri-badge { display: flex; }
.ri-badge.del { background: #c86a6a; top: -14px; right: -14px; }
.ri-badge.flip { background: #8a9ab8; top: -14px; left: -14px; right: auto; }

/* ---------- 布置工具 ---------- */
.room-edit-btn {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 20;
  min-width: 40px;
  height: 36px;
  padding: 0 12px;
  border: var(--pixel-border);
  border-radius: 12px;
  background: var(--c-card-glass);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: bold;
  color: var(--c-text);
  cursor: pointer;
  box-shadow: 0 4px 10px var(--c-shadow);
  transition: all 0.2s ease;
}

/* 总金币标签 */
.room-coin {
  position: absolute;
  top: 10px;
  left: 10px;
  z-index: 20;
  font-family: var(--font-pixel);
  font-size: 9px;
  font-weight: bold;
  color: #8a6a30;
  background: rgba(255, 252, 245, 0.8);
  border: 2.5px solid var(--c-line);
  border-radius: 999px;
  padding: 7px 10px;
  box-shadow: 0 3px 8px var(--c-shadow);
  pointer-events: none;
}
.room-edit-btn:active { transform: scale(0.9); }
body.room-editing .room-edit-btn {
  background: var(--c-accent);
  color: #fff;
  box-shadow: 0 4px 0 #b08550;
}

.room-edit-bar {
  position: absolute;
  left: 50%;
  bottom: 10px;
  transform: translateX(-50%);
  z-index: 21;
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(50, 38, 26, 0.9);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 14px;
  padding: 8px 10px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  max-width: calc(100% - 16px);
  animation: bar-slide-up 0.25s ease;
}
/* 关键：hidden 属性必须生效，编辑栏只在布置模式出现 */
.room-edit-bar[hidden] { display: none; }
@keyframes bar-slide-up {
  from { transform: translateX(-50%) translateY(12px); opacity: 0; }
  to   { transform: translateX(-50%) translateY(0); opacity: 1; }
}
@keyframes bar-slide-down {
  from { transform: translateX(-50%) translateY(0); opacity: 1; }
  to   { transform: translateX(-50%) translateY(14px); opacity: 0; }
}
/* 退出编辑模式：编辑栏平滑收起 */
.room-edit-bar.closing { animation: bar-slide-down 0.2s ease forwards; }

.room-edit-hint {
  color: rgba(255, 243, 224, 0.75);
  font-size: 10px;
  white-space: nowrap;
  margin-right: 2px;
}

.room-edit-act {
  border: none;
  border-radius: 10px;
  padding: 8px 10px;
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: bold;
  color: #5a4a3a;
  background: #f5e8d4;
  cursor: pointer;
  transition: all 0.15s ease;
  white-space: nowrap;
}
.room-edit-act:active { transform: scale(0.92); }
.room-edit-act:disabled { opacity: 0.4; cursor: not-allowed; }
.room-edit-act.primary { background: var(--c-accent); color: #fff; }
.room-edit-act.danger { background: #c86a6a; color: #fff; }

/* ---------- 背景切换器（左下角） ---------- */
.bg-add-btn {
  position: absolute;
  left: 10px;
  bottom: 10px;
  z-index: 20;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  border: 2px dashed rgba(255, 243, 224, 0.75);
  background: rgba(50, 38, 26, 0.78);
  color: rgba(255, 243, 224, 0.85);
  font-size: 16px;
  line-height: 1;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}
.bg-add-btn:hover { background: rgba(70, 55, 40, 0.9); transform: scale(1.1); }

.bg-switcher {
  position: absolute;
  left: 48px;
  bottom: 10px;
  z-index: 19;
  display: flex;
  gap: 6px;
  max-width: calc(100% - 140px);
  overflow-x: auto;
  padding: 4px;
  background: rgba(50, 38, 26, 0.78);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 12px;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
}

.bg-thumb {
  position: relative;
  width: 52px;
  flex-shrink: 0;
  border-radius: 9px;
  overflow: hidden;
  border: 2px solid transparent;
  cursor: pointer;
  opacity: 0.72;
  transition: all 0.2s ease;
  background: #2a2018;
}
.bg-thumb img {
  width: 100%;
  height: 46px;
  object-fit: cover;
  display: block;
  image-rendering: pixelated;
}
.bg-thumb-name {
  display: block;
  text-align: center;
  font-size: 9px;
  color: rgba(255, 243, 224, 0.9);
  padding: 2px 0 3px;
  letter-spacing: 0.5px;
}
.bg-thumb:hover { opacity: 1; transform: translateY(-2px); }
.bg-thumb.active {
  border-color: #ffd9a0;
  opacity: 1;
  box-shadow: 0 0 0 2px rgba(255, 217, 160, 0.35);
}

.bg-thumb-del {
  position: absolute;
  top: 2px;
  right: 2px;
  width: 15px;
  height: 15px;
  border-radius: 50%;
  background: rgba(200, 80, 80, 0.92);
  color: #fff;
  font-size: 10px;
  line-height: 15px;
  text-align: center;
  cursor: pointer;
  display: none;
}
.bg-thumb:hover .bg-thumb-del { display: block; }

/* 编辑模式下隐藏背景切换器，避免误触 */
body.room-editing .bg-switcher,
body.room-editing .bg-add-btn { display: none; }

/* ---------- 小我（像素小人走路 cycle） ---------- */
.xiaowo {
  position: absolute;
  left: 50%;
  bottom: 8%;
  width: 44px;
  height: 56px;
  margin-left: -22px;
  cursor: pointer;
  user-select: none;
  -webkit-user-drag: none;
}

.xiaowo-sprite {
  position: absolute;
  inset: 0;
  background-image: url('../assets/pixel/xiaowo-sheet.png');
  background-size: 400% 100%;      /* 4 帧横排等宽 */
  background-repeat: no-repeat;
  background-position: 0 0;
  image-rendering: pixelated;
  animation: xw-walk 1.2s steps(4, end) infinite;
  transition: filter 0.3s ease, transform 0.3s ease;
  filter: drop-shadow(0 2px 2px rgba(60, 35, 20, 0.3));
}

@keyframes xw-walk {
  from { background-position: 0 0; }
  to   { background-position: 100% 0; }
}

.xiaowo-shadow {
  position: absolute;
  bottom: -2px;
  left: 50%;
  transform: translateX(-50%);
  width: 30px;
  height: 7px;
  background: radial-gradient(ellipse, rgba(60, 40, 20, 0.35) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

/* 小我开心的反应：跳一下 */
.xiaowo.mood-happy .xiaowo-sprite {
  animation: xw-jump 0.6s ease, xw-walk 1.1s steps(4, end) infinite;
}
@keyframes xw-jump {
  0%   { transform: translateY(0); }
  30%  { transform: translateY(-16px); }
  55%  { transform: translateY(0); }
  75%  { transform: translateY(-6px); }
  100% { transform: translateY(0); }
}

.xiaowo:hover .xiaowo-sprite {
  transform: scale(1.08);
}

/* 点击提示气泡 */
.xiaowo-click-hint {
  position: absolute;
  bottom: calc(100% + 6px);
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  font-size: 9px;
  font-weight: bold;
  color: #7a5a3a;
  background: rgba(255, 252, 245, 0.85);
  border: 1.5px solid var(--c-line);
  border-radius: 999px;
  padding: 2px 8px;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
  animation: hint-float 2.8s ease-in-out infinite;
}
.xiaowo:hover .xiaowo-click-hint { opacity: 1; }
@keyframes hint-float {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50%      { transform: translateX(-50%) translateY(-3px); }
}

/* ============================================================
   自我照顾常驻表单 - 行式列表
   ============================================================ */
.tab1-care {
  position: relative;
  height: 42%;
  min-height: 262px;
  background: var(--c-card-glass);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: var(--pixel-border-thick);
  padding: 12px 16px 14px;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8px 24px var(--c-shadow);
}

.tab1-care::before {
  content: '';
  position: absolute;
  top: -8px;
  left: 0;
  right: 0;
  height: 8px;
  background-image: linear-gradient(135deg, transparent 33%, var(--c-card-glass) 33%, var(--c-card-glass) 66%, transparent 66%);
  background-size: 12px 8px;
  background-repeat: repeat-x;
}

.care-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.care-title {
  font-size: 15px;
  font-weight: bold;
  color: var(--c-text);
  letter-spacing: 0.5px;
}

.care-meta {
  display: flex;
  gap: 8px;
  font-family: var(--font-pixel);
  font-size: 9px;
}

.care-meta-item {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  color: var(--c-text-soft);
  background: rgba(255, 255, 255, 0.6);
  padding: 4px 8px;
  border-radius: var(--r-pill);
  border: 2px solid var(--c-line);
}

.care-meta-item b { color: var(--c-accent); }

/* 行式列表 */
.care-options {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding-right: 2px;
}

.care-row {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(255, 255, 255, 0.72);
  border: 2.5px solid var(--c-line);
  border-radius: 12px;
  padding: 7px 12px;
  cursor: pointer;
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: bold;
  color: var(--c-text);
  transition: all 0.15s ease;
  user-select: none;
  flex-shrink: 0;
  position: relative;
}

.care-row:active { transform: scale(0.985); }

/* 像素图标（meta 心形 / 金币） */
.pix-icon {
  width: 12px;
  height: 12px;
  flex-shrink: 0;
  display: inline-block;
}
.pix-icon.pix-heart { fill: #d4758a; }
.pix-icon.pix-coin { fill: #d9a441; }

/* 行内像素图标（照顾选项） */
.care-row-icon {
  width: 26px;
  height: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.2s ease;
  filter: grayscale(15%);
}
.care-row-icon svg {
  width: 20px;
  height: 20px;
  display: block;
}

.care-row-label { flex: 1; }

.care-row-check {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 2.5px solid #c9b89a;
  background: #fff;
  color: transparent;
  font-size: 13px;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.care-row.selected {
  background: #fbe4d0;
  border-color: var(--c-accent);
}
.care-row.selected .care-row-icon {
  transform: scale(1.15) rotate(-6deg);
  filter: grayscale(0%) drop-shadow(0 2px 3px rgba(120, 90, 60, 0.25));
}
.care-row.selected .care-row-check {
  background: var(--c-accent);
  border-color: var(--c-accent);
  color: #fff;
}

.care-row.submitted {
  background: var(--c-mint);
  border-color: #88b8a0;
  color: #305040;
  pointer-events: none;
}
.care-row.submitted .care-row-check {
  background: #88b8a0;
  border-color: #88b8a0;
  color: #fff;
}

.care-row.tapped { animation: tap-pop 0.4s ease; }
@keyframes tap-pop {
  0%   { transform: scale(1); }
  30%  { transform: scale(0.96); }
  60%  { transform: scale(1.02); }
  100% { transform: scale(1); }
}

.care-confirm {
  margin-top: 10px;
  flex-shrink: 0;
  height: 42px;
  border: var(--pixel-border);
  border-radius: var(--r-md);
  background: var(--c-accent);
  color: #fff;
  font-family: var(--font-body);
  font-size: 15px;
  font-weight: bold;
  letter-spacing: 1px;
  cursor: pointer;
  box-shadow: 0 4px 0 #b08550, 0 6px 12px var(--c-shadow);
  transition: all 0.15s ease;
}
.care-confirm:active:not(:disabled) {
  transform: translateY(2px);
  box-shadow: 0 2px 0 #b08550, 0 3px 6px var(--c-shadow);
}
.care-confirm:disabled {
  background: #d8c8a8;
  color: #a89878;
  cursor: not-allowed;
  box-shadow: 0 4px 0 #b8a888, 0 6px 12px var(--c-shadow);
}
